<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="screenOrientation" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".baozi.BaoziMenuActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".baozi.HelpActivity"
            android:exported="false"
            android:screenOrientation="behind" />

        <activity
            android:name=".baozi.ForwardActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".baozi.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".baozi.ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".baozi.GameActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/GameTheme" />

        <activity
            android:name=".merge.MergeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/GameTheme" />

        <activity
            android:name=".journey.JourneyActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/GameTheme" />

        <activity
            android:name=".chess.ChessActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/GameTheme" />
    </application>
</manifest>
